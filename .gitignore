.DS_Store
__pycache__/
*.pyc
# Rushes vidéo lourds : à garder hors Git (hébergés ailleurs)
CONTENU/04_BANQUE_BROLL/**/*.mp4
CONTENU/04_BANQUE_BROLL/**/*.mov
.env
# Journaux du navigateur Playwright (veille)
.playwright-mcp/
# Environnement Python local (faster-whisper pour reel.py)
.venv/
# Montage des reels : fichiers de travail et vidéos (hébergées ailleurs, jamais dans Git)
CONTENU/07_PRET_A_PUBLIER/**/_build/
CONTENU/07_PRET_A_PUBLIER/**/*.mp4
CONTENU/07_PRET_A_PUBLIER/**/*.wav

# Photos de personnalités déposées par le fondateur (droits : décision du fondateur, hors Git)
CONTENU/05_BANQUE_IMAGES/personnalites/*
!CONTENU/05_BANQUE_IMAGES/personnalites/README.md

# Vidéos YouTube du fondateur téléchargées pour en tirer des reels (hors Git)
CONTENU/08_YOUTUBE/**/*.mp4
CONTENU/08_YOUTUBE/**/*.m4a
CONTENU/08_YOUTUBE/**/*.webm
CONTENU/08_YOUTUBE/**/*.wav
CONTENU/08_YOUTUBE/**/_frames/
CONTENU/08_YOUTUBE/**/*.json3
