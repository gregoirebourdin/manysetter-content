  "sous_titres": [
    {
      "de": 869.36,
      "a": 871.9,
      "texte": "We're sending it a first message."
    },
    {
      "de": 872.12,
      "a": 881.1,
      "texte": "For example, *\"Hello, I'm interested in ecom.\"*"
    },
    {
      "de": 885.3,
      "a": 890.3,
      "texte": "Now we wait and see what our setter replies."
    },
    {
      "de": 891.16,
      "a": 895.86,
      "texte": "It asks if I already sell or if I'm just starting out."
    },
    {
      "de": 896.12,
      "a": 898.95,
      "texte": "I tell it I already make *1k a month*."
    },
    {
      "de": 902.4,
      "a": 904.45,
      "texte": "It asks what I'm selling right now."
    },
    {
      "de": 904.56,
      "a": 906.65,
      "texte": "I answer, dog products."
    },
    {
      "de": 906.68,
      "a": 908.95,
      "texte": "It replies, nice niche."
    },
    {
      "de": 908.96,
      "a": 911.4,
      "texte": "How long have you been in ecom?"
    },
    {
      "de": 913.8,
      "a": 914.8,
      "texte": "I say two years."
    },
    {
      "de": 955.8,
      "a": 960.95,
      "texte": "It asks if I have *3k set aside* to invest in this."
    },
    {
      "de": 961.64,
      "a": 962.95,
      "texte": "I say yes, why not?"
    },
    {
      "de": 963.44,
      "a": 964.85,
      "texte": "It recaps everything"
    },
    {
      "de": 964.85,
      "a": 966.95,
      "texte": "and says the next step is a *30-minute call*."
    },
    {
      "de": 967.4,
      "a": 968.66,
      "texte": "I tell it I'm in."
    },
    {
      "de": 969.08,
      "a": 970.2,
      "texte": "It sends me the link,"
    },
    {
      "de": 970.2,
      "a": 977.7,
      "texte": "I tell it I booked a call for tomorrow at 4 p.m."
    },
    {
      "de": 977.7,
      "a": 979.8,
      "texte": "and it says, *\"Perfect, see you at 4.\"*"
    }
  ],
