  "sous_titres": [
    {
      "de": 44.08,
      "a": 48.4,
      "texte": "First, what you need to understand"
    },
    {
      "de": 48.4,
      "a": 53.5,
      "texte": "is that AI setters let you answer DMs everywhere, *all the time*."
    },
    {
      "de": 53.84,
      "a": 58.9,
      "texte": "That means WhatsApp, Messenger, Instagram,"
    },
    {
      "de": 58.9,
      "a": 60.4,
      "texte": "it can reply *24/7*."
    },
    {
      "de": 98.92,
      "a": 102.9,
      "texte": "What's also interesting is that they *qualify* the prospect."
    },
    {
      "de": 103.36,
      "a": 108.6,
      "texte": "They ask questions every time, they take an interest in the prospect,"
    },
    {
      "de": 108.84,
      "a": 113.8,
      "texte": "whereas a human setter might be *tired*, or in a mood,"
    },
    {
      "de": 113.88,
      "a": 119.5,
      "texte": "and then you can't get the full capacity and potential"
    },
    {
      "de": 119.6,
      "a": 122.9,
      "texte": "for your coach, or for high-ticket sales."
    },
    {
      "de": 123.24,
      "a": 127.2,
      "texte": "So you get a lot of qualification, and a lot of *availability*."
    }
