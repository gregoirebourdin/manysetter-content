    {
      "blocks": [
        {
          "heading": "*second thing*"
        },
        {
          "lead": "i'd answer the question, not the keyword."
        },
        {
          "text": "a lead writes \"is this for beginners? i've been burned before\". a keyword flow sees \"beginners\" and sends the booking link.\n\nthat's like answering \"i'm scared of dogs\" with a puppy."
        },
        {
          "collage": [
            "CONTENU/05_BANQUE_IMAGES/ecrans/flow-beginners/slide-01.png",
            "CONTENU/05_BANQUE_IMAGES/ecrans/setter-beginners/slide-01.png"
          ],
          "width": 440
        }
      ]
    },
    {
      "bg": "black",
      "blocks": [
        {
          "title": "a lead rarely ghosts you over the *price*"
        },
        {
          "text": "they ghost when the **second message** never gets an answer.",
          "align": "center"
        }
      ]
    },
    {
      "blocks": [
        {
          "heading": "*third thing*"
        },
        {
          "lead": "i'd only send my calendar to the right people."
        },
        {
          "text": "\"this week i had 6 consult calls booked. none of them turned into a real client.\" sound familiar?\n\nbefore the link, i'd check what they want and if the budget is real. everyone else gets something useful. just not your tuesday afternoon."
        },
